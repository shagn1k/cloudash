# Copy this file to ".env" for local development. ".env" is git-ignored.
# Never put AWS access keys in this file for deployed environments - use the EC2 IAM role.

# 5001 because macOS uses 5000 for AirPlay Receiver
PORT=5001

# development = simulated infrastructure data | aws = real data via AWS SDK
# (aws mode returns 501 for /api/status and /api/metrics until the AWS integration is built in Phase 8)
APP_MODE=development

# Origin of the React dev server (allowed to call this API)
CORS_ORIGIN=http://localhost:5173

# ---- Optional deployment metadata (reported by GET /api/deployment) ----
# In AWS these are injected by the CI/CD pipeline when it starts the container.
# Locally they have sensible defaults, so you can leave them commented out.
# APP_VERSION=v1.0.0
# APP_ENVIRONMENT=production
# DEPLOYMENT_STATUS=success
# DEPLOYED_AT=2026-01-01T00:00:00Z
# IMAGE_VERSION=<account>.dkr.ecr.<region>.amazonaws.com/cloudopshub:<tag>
